# Copy to .env (gitignored) and fill in. Placeholders only.
# Optional: without a key the Anthropic SDK uses ANTHROPIC_API_KEY or your `ant auth login` profile.
# CHESS_TUTOR_LLM_API_KEY=
# CHESS_TUTOR_LLM_PROVIDER=anthropic   # "none" runs without a coach
# CHESS_TUTOR_BACKEND_HOST=127.0.0.1
# CHESS_TUTOR_BACKEND_PORT=8000
# FRONTEND_PORT=3000
# CHESS_TUTOR_STOCKFISH_PATH=/usr/games/stockfish
# CHESS_TUTOR_STOCKFISH_POOL_SIZE=2
# CHESS_TUTOR_MAIA_DEVICE=cpu
# CHESS_TUTOR_MAIA_MODEL=5m   # 3m | 5m | 23m | 79m
# CHESS_TUTOR_OPPONENT_ENGINE=maia3   # maia3 | maia2 | stockfish
# CHESS_TUTOR_OPPONENT_STOCKFISH_ABOVE_ELO=2000   # above this Elo, Stockfish (UCI_Elo) plays
# CHESS_TUTOR_OPPONENT_STEERING_ENABLED=false   # stretch: bias replies toward your FOCUS-concept motifs
# CHESS_TUTOR_OPPONENT_STEERING_RATE=0.25   # share of moves that may be steered
# CHESS_TUTOR_OPPONENT_STEERING_MAX_EVAL_LOSS_CENTIPAWNS=30   # never pay more than this vs Maia's top move

# Docker Compose (see deploy/README.md). Defaults bind to loopback; put a reverse proxy in front.
# CHESS_TUTOR_FRONTEND_ORIGINS=["https://chess.example.com"]   # must include the public frontend origin
# NEXT_PUBLIC_API_BASE_URL=https://api.chess.example.com       # baked into the frontend image at build time
# CHESS_TUTOR_BACKEND_BIND=127.0.0.1
# CHESS_TUTOR_FRONTEND_BIND=127.0.0.1
